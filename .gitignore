# --- Claude Code local / personal (keep shared config committed) ---
CLAUDE.local.md
.claude/settings.local.json
.claude/*.local.json

# --- Devcontainer generated ---
.devcontainer/.env

# --- Secrets (never commit; charter §2.5) ---
deploy/dev/.zitadel/
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
# uv.lock is NOT committed, and that is a decision rather than an oversight. pyproject.toml
# expresses this repo's Python tooling as FLOORS (`ruff>=0.14.0`, …) that the quarterly evergreen
# train raises (§1.7); a lockfile would pin exact versions beside those floors — a second home for
# one fact (§2.4), and one that silently freezes what the floors exist to let float. The versions
# that must be exact are pinned AT THE CALL SITE in Taskfile.yml (`uvx ruff@{{.RUFF_VER}}`), which
# is also where the EE content gate hash-verifies them. It reappears whenever `uv run` is invoked,
# so it is ignored rather than deleted.
uv.lock
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node / frontend ---
node_modules/
.vite/
coverage/
*.tsbuildinfo

# --- Go ---
/bin/
*.test
*.out

# --- Task runner ---
.task/

# --- Editors / OS ---
.DS_Store
*.log

# --- Helm ---
deploy/charts/*/charts/*.tgz
.playwright-mcp/

# pinned cluster tooling installed by tools:helm / tools:kubectl / tools:tofu
.bin/

# --- OpenTofu ---
# The downloaded provider plugins + working state are per-machine scratch. The
# LOCKFILE is the opposite and is deliberately NOT ignored: .terraform.lock.hcl
# carries the provider HASH pins, and committing it is ADR-0112 D4's binding
# condition for shipping the module at all (§7.3).
deploy/tofu-modules/*/.terraform/
deploy/tofu-modules/*/*.tfstate
deploy/tofu-modules/*/*.tfstate.backup

# stray Go build outputs (binaries built into the repo root)
strattd
core/stratt-forwarder
core/strattd
core/stratt-agent
core/stratt

# Staged reference estate for the dev inline-declarations ConfigMap. Populated
# from /estate by `task dev:stage-estate` (Helm can't glob outside the chart dir);
# the single source of truth is /estate, never this copy.
/deploy/charts/stratt/dev/declarations/

# ADR-0084 convergence-demo SSH keypair (machine credential material — never commit)
deploy/dev/managed-web/
# The dev DNS TSIG key — generated by `task dev:dns:key`, never committed (§2.5).
deploy/dev/dns/tsig.env

# app-cert demo SSH keypair (machine credential material — never commit, §2.5)
deploy/dev/app-cert/

# network-device demo SSH keypair (machine credential material — never commit, §2.5).
# Its absence here let a generated PRIVATE KEY into a commit: the Taskfile target that mints it says
# "never committed (§2.5)", and that was true of app-cert's directory and untrue of this one, because
# the claim lived in a comment beside the generator rather than in the file that enforces it. Caught
# before it was pushed; the key was regenerated regardless, since a key that reached an object store
# is a key that leaked.
deploy/dev/network-device/

# vspheresim dev binary (task dev:vspheresim:up runs it with `go run`)
plugins/vcenter/vspheresim
